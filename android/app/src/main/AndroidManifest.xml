<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Each permission is added together with the feature that needs it and
         must be on the allowed list in CLAUDE.md 4. -->
    <!-- The phone's own GPS, for the route and as a check on the car's speed. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- A phone without GPS can still run everything else. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- Bluetooth, for an ELM327 adapter (CLAUDE.md 4). Android 12 and later ask for
         the two new permissions at run time; before that, the old ones are granted
         at install time. Scanning never needs the location permission on Android 12+
         (neverForLocation), and before it the GPS permission above serves. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <!-- A phone without Bluetooth can still run the demo and a WiFi adapter. -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- Android requires this for any socket, including one to a WiFi ELM327 on a
         private network. The network guard in lib/obd/transport/wifi_transport.dart
         refuses every other address (CLAUDE.md 4). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- allowBackup is off because Android Auto Backup uploads app data to the
         user's Google account, and TapeDash is strictly offline. -->
    <application
        android:label="TapeDash"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:screenOrientation="sensorLandscape"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Hands a picture the app drew (Year on Tape) to Android's share sheet,
             readable from one cache folder only. It needs no permission and
             sends nothing by itself. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
